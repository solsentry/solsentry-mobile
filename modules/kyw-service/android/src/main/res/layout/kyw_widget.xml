<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kyw_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/kyw_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="10dp"
  android:paddingEnd="14dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/kyw_widget_dot"
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:layout_marginEnd="6dp"
      android:importantForAccessibility="no"
      android:src="@drawable/kyw_widget_dot_off" />

    <TextView
      android:id="@+id/kyw_widget_status"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Verification is off"
      android:textColor="#8D928B"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:baselineAligned="true"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/kyw_widget_figure"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="–"
      android:textColor="#F2F1EB"
      android:textSize="26sp" />

    <TextView
      android:id="@+id/kyw_widget_unit"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:maxLines="1"
      android:textColor="#F5A05B"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/kyw_widget_today"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#F2F1EB"
    android:textSize="12sp"
    android:visibility="gone" />

</LinearLayout>
