{
  "expo": {
    "name": "SolSentry",
    "slug": "solsentry-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solsentry",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100E0A",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#100E0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.solsentry.mobile",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Syne",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Syne_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Syne_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Syne_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "DMSans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/DMSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/DMSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/DMSans_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/DMSans_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#100E0A"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
